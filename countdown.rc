#pragma code_page(65001)
#include <windows.h>
#include "resources.h"

IDI_COUNTDOWN ICON "countdown.ico"
1 RT_MANIFEST "countdown.manifest"

IDD_PALETTE DIALOGEX 0, 0, 356, 116
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "配色"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "全天预览", -1, 10, 8, 54, 11
    CONTROL "", IDC_DAY_VIEW, "Static", SS_OWNERDRAW, 10, 22, 336, 52
    LTEXT "配色", -1, 10, 91, 24, 11
    COMBOBOX IDC_THEME, 38, 88, 130, 65, CBS_DROPDOWNLIST | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 238, 88, 50, 15
    PUSHBUTTON "取消", IDCANCEL, 296, 88, 50, 15
END

IDD_SETTINGS DIALOGEX 0, 0, 290, 138
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "时区", -1, 12, 15, 47, 10
    COMBOBOX IDC_ZONE, 64, 12, 214, 145, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "日照地点", -1, 12, 37, 47, 10
    COMBOBOX IDC_CITY, 64, 34, 214, 114, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "纬度", -1, 64, 60, 24, 10
    EDITTEXT IDC_LATITUDE, 91, 57, 62, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "经度", -1, 170, 60, 24, 10
    EDITTEXT IDC_LONGITUDE, 197, 57, 81, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "北纬、东经为正，南纬、西经为负。", -1, 64, 76, 212, 10
    AUTOCHECKBOX "开机自动启动（登录 Windows 后）", IDC_AUTOSTART, 64, 94, 210, 12, WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 174, 116, 49, 14, WS_TABSTOP
    PUSHBUTTON "取消", IDCANCEL, 229, 116, 49, 14, WS_TABSTOP
END
